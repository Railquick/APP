# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Client-side, prefixed with VITE_)
# Only public values belong here. Never put secrets or API keys here.
# ------------------------------------------------------------------------------

# Optional: Base URL of your backend. In local dev, Vite automatically proxies
# /api to http://localhost:8787 when this is left empty.
VITE_API_BASE_URL=

# Google OAuth *Web client ID* (public)
VITE_GOOGLE_CLIENT_ID=

# Support and policy URLs
VITE_SUPPORT_URL=
VITE_INSTAGRAM_URL=https://www.instagram.com/
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_CONTENT_POLICY_URL=

# ------------------------------------------------------------------------------
# BACKEND SECRETS & CONFIGURATION (Server-side ONLY)
# Store these in `.env.local` or `.env`. Never commit secrets to git.
# ------------------------------------------------------------------------------

# Official RailKit Indian Railways API Key (Get from https://railkit.in)
RAILKIT_API_KEY=your_rotated_railkit_api_key_here

# Server port (default: 8787)
PORT=8787

# Session secret for test auth tokens
SESSION_SECRET=your_random_32_byte_hex_string_here

# Supabase (SERVER-SIDE ONLY). The service-role key bypasses RLS - never expose it
# to the browser and never give it a VITE_ prefix. Used for "Request RailQuick in
# Your Train" (table: railquick_train_requests, see supabase/migrations).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Secret for the operations team's /api/admin/* routes (send as `x-admin-key`).
# Generate with: openssl rand -hex 24. Leave empty to disable the admin routes.
ADMIN_API_KEY=

# Testing phase active delivery stations (comma-separated railway station codes)
DELIVERY_STATIONS=NDLS,NZM,DLI,ANVT,DEE

# Delivery fee in paise (3000 = ₹30)
DELIVERY_FEE_PAISE=3000

# Free delivery threshold in paise (49900 = ₹499)
FREE_DELIVERY_ABOVE_PAISE=49900
